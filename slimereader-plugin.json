{
    "id": "slimereader-plugin",
    "name": "Slime Reader",
    "version": "3.0.0",
    "manifestURI": "https://raw.githubusercontent.com/FemboyEnjoyerAndLover/slime-reader-seanime/main/slimereader-plugin.json",
    "description": "Read all 21 volumes of 'That Time I Got Reincarnated as a Slime' light novel inside Seanime, with automatic reading progress saved per volume.",
    "author": "FemboyEnjoyerAndLover",
    "icon": "",
    "language": "typescript",
    "type": "plugin",
    "payloadURI": "https://raw.githubusercontent.com/FemboyEnjoyerAndLover/slime-reader-seanime/main/slimereader-plugin.ts",
    "lang": "EN",
    "plugin": {
        "version": "1",
        "permissions": {
            "scopes": [],
            "allow": {
                "unsafeFlags": [
                    {
                        "flag": "dom-script-manipulation",
                        "reason": "Needed to inject the reader UI and fetch chapter content into Seanime's DOM"
                    }
                ]
            }
        }
    }
}
